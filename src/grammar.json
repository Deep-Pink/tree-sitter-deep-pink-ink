{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "deep_pink_ink",
  "word": "identifier",
  "rules": {
    "line_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "triple_greater"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "unit_command"
            },
            {
              "type": "SYMBOL",
              "name": "named_command"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "stop_token"
        }
      ]
    },
    "tag_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "hash"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "named_command"
            },
            {

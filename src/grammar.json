        {
          "type": "SYMBOL",
          "name": "eol"
        },
        {
          "type": "SYMBOL",
          "name": "eof"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_]([A-Za-z0-9_]*)"
    },
    "named_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "CHOICE",
